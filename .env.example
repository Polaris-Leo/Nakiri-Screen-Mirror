# Host path for Compose's file-backed Docker secret; create locally, never commit it.
TURN_SECRET_FILE=./secrets/turn_secret
# Replace this TEST-NET example with the server's public IP.
TURN_EXTERNAL_IP=203.0.113.10
TURN_REALM=turn.example.com
# Browser media connects directly to coturn, not through EdgeOne.
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
TURN_CREDENTIAL_TTL_SECONDS=3600
ALLOWED_ORIGINS=https://mirror.example.com
# Enable only when Node is reachable solely through the trusted EdgeOne proxy.
TRUST_PROXY=false
