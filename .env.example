# TURN's long-term shared secret must remain server-side (mount as a Docker secret).
TURN_SECRET_FILE=/run/secrets/turn_secret
TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_CREDENTIAL_TTL_SECONDS=3600
ALLOWED_ORIGINS=https://mirror.example.com
# Enable only when Node is reachable solely through the trusted EdgeOne proxy.
TRUST_PROXY=false
